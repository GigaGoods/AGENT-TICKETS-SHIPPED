# Agent Tickets — environment configuration
#
# Copy to .env and fill in. Devnet only; do not point these at mainnet.
# NEVER commit .env to git.

# --- Solana ---------------------------------------------------------------

# RPC endpoint. The public devnet endpoint is rate-limited and fine for local
# work; use a provider (Helius, QuickNode, Triton) before anything shared.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Cluster the frontend and wallet adapter connect to: devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Deployed escrow program ID. Printed by `npm run anchor:deploy` and also
# written into Anchor.toml / the generated IDL.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=

# USDC SPL mint. This is the devnet mint — the mainnet mint is a different
# address, so this must change with the cluster.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Escrow ---------------------------------------------------------------

# Seconds before an unconfirmed purchase settles automatically. The backstop for
# a buyer who never confirms receipt; the program enforces this, not the client.
ESCROW_TIMEOUT_SECONDS=259200

# --- Agent access ---------------------------------------------------------

# Base URL the MCP server calls for the public marketplace API.
AGENT_API_BASE_URL=http://localhost:3000/api

# Shared secret for agent API calls. Leave empty to allow unauthenticated reads
# in local development; required before any deployment.
AGENT_API_KEY=

# --- Document verification (vision APIs) -----------------------------------

# Default provider: Google Gemini Vision
VISION_PROVIDER=google

# --- Google Gemini (default) ---
# Get a free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-key-here
GOOGLE_VISION_MODEL=gemini-flash-latest

# --- OpenAI (optional alternative) ---
# Get a key: https://platform.openai.com/api-keys
# VISION_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_VISION_MODEL=gpt-4o

# Port for the verification/demo server (server.js)
PORT=3000
